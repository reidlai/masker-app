<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SleepApneaProcess" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN.js Model Platform" exporterVersion="11.0.0">
  <bpmn:collaboration id="Collaboration_SleepApnea">
    <bpmn:participant id="Participant_Onboarding" name="Patient Onboarding" processRef="Process_Onboarding" />
    <bpmn:participant id="Participant_Backoffice" name="Backoffice Operations" processRef="Process_Backoffice" />
    <bpmn:participant id="Participant_Patient" name="Patient Sleep Operations" processRef="Process_Patient" />
    <bpmn:participant id="Participant_EmergencyCenter" name="Emergency Center" processRef="Process_EmergencyCenter" />
    <bpmn:participant id="Participant_Clinic" name="Clinic &#38; Physician [Future]" processRef="Process_Clinic" />
    
    <bpmn:messageFlow id="Flow_Registration_Backoffice" name="Patient Profile &#38; Device Serial" sourceRef="Task_CreateUserProfile" targetRef="Task_VerifyPatientIdentity" />
    <bpmn:messageFlow id="Flow_Passkey_Auth" name="Registered Passkey Credential" sourceRef="Task_RegisterPasskey" targetRef="Task_PasskeyAuth" />
    <bpmn:messageFlow id="Flow_Emergency_Dispatch" name="30s Unacknowledged Alarm Push" sourceRef="Task_SleepMonitoring" targetRef="Task_DashboardAlert" />
    <bpmn:messageFlow id="Flow_Morning_Sync" name="Morning Sleep Summary &#38; AHI Score" sourceRef="Task_EndSession" targetRef="Task_DoctorSync" />
  </bpmn:collaboration>

  <!-- SWIMLANE 1: PATIENT ONBOARDING -->
  <bpmn:process id="Process_Onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Onboarding">
      <bpmn:lane id="Lane_PatientOnboarding" name="Patient Onboarding">
        <bpmn:flowNodeRef>Start_Onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PatientRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUserProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterPasskey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OnboardingComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Onboarding" name="Start: First App Launch">
      <bpmn:outgoing>Flow_O1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PatientRegister" name="Register Patient Account">
      <bpmn:incoming>Flow_O1</bpmn:incoming>
      <bpmn:outgoing>Flow_O1b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreateUserProfile" name="Create Patient Medical Profile">
      <bpmn:incoming>Flow_O1b</bpmn:incoming>
      <bpmn:outgoing>Flow_O2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RegisterPasskey" name="Register &#38; Enroll FIDO2 Passkey">
      <bpmn:incoming>Flow_O2</bpmn:incoming>
      <bpmn:outgoing>Flow_O3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OnboardingComplete" name="End: Profile &#38; Passkey Created">
      <bpmn:incoming>Flow_O3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_O1" sourceRef="Start_Onboarding" targetRef="Task_PatientRegister" />
    <bpmn:sequenceFlow id="Flow_O1b" sourceRef="Task_PatientRegister" targetRef="Task_CreateUserProfile" />
    <bpmn:sequenceFlow id="Flow_O2" sourceRef="Task_CreateUserProfile" targetRef="Task_RegisterPasskey" />
    <bpmn:sequenceFlow id="Flow_O3" sourceRef="Task_RegisterPasskey" targetRef="End_OnboardingComplete" />
  </bpmn:process>

  <!-- SWIMLANE 2: BACKOFFICE OPERATIONS -->
  <bpmn:process id="Process_Backoffice" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Backoffice">
      <bpmn:lane id="Lane_BackofficePlatform" name="Backoffice Operations">
        <bpmn:flowNodeRef>Start_Backoffice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPatientIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BindMedicalDevice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LockEmergencyContacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BackofficeComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Backoffice" name="Start: Registration Trigger">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_VerifyPatientIdentity" name="Verify Patient Identity &#38; Eligibility">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BindMedicalDevice" name="Pair &#38; Bind Hardware Sensor Serial">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LockEmergencyContacts" name="Lock Caregiver Emergency Contacts">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BackofficeComplete" name="End: Account Provisioned">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Start_Backoffice" targetRef="Task_VerifyPatientIdentity" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_VerifyPatientIdentity" targetRef="Task_BindMedicalDevice" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_BindMedicalDevice" targetRef="Task_LockEmergencyContacts" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_LockEmergencyContacts" targetRef="End_BackofficeComplete" />
  </bpmn:process>

  <!-- SWIMLANE 3: PATIENT SLEEP OPERATIONS -->
  <bpmn:process id="Process_Patient" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Patient">
      <bpmn:lane id="Lane_PatientAtHome" name="Patient Sleep Operations">
        <bpmn:flowNodeRef>Start_Bedtime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PasskeyAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stage1Cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stage2Cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SleepMonitoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Tier1Alarm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PatientAwake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TapSafe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EndSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SessionComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Bedtime" name="Start: Bedtime Session">
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PasskeyAuth" name="Authenticate via Passkey (FIDO2)">
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Stage1Cal" name="Execute Stage 1 Idle Noise Calibration">
      <bpmn:incoming>Flow_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Stage2Cal" name="Execute Stage 2 Active Breath Calibration">
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SleepMonitoring" name="Sleep with Device Attached">
      <bpmn:incoming>Flow_P4</bpmn:incoming>
      <bpmn:incoming>Flow_AlarmNo</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Tier1Alarm" name="Tier-1 Mobile Alarm Triggered?">
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_AlarmNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_AlarmYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_AlarmNo" name="No" sourceRef="Gateway_Tier1Alarm" targetRef="Task_SleepMonitoring" />
    <bpmn:exclusiveGateway id="Gateway_PatientAwake" name="Patient Awake within 30s?">
      <bpmn:incoming>Flow_AlarmYes</bpmn:incoming>
      <bpmn:outgoing>Flow_AwakeYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwakeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_AlarmYes" name="Yes" sourceRef="Gateway_Tier1Alarm" targetRef="Gateway_PatientAwake" />
    <bpmn:userTask id="Task_TapSafe" name="Tap &#39;I&#39;m Safe&#39; Button">
      <bpmn:incoming>Flow_AwakeYes</bpmn:incoming>
      <bpmn:outgoing>Flow_P6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AwakeYes" name="Yes" sourceRef="Gateway_PatientAwake" targetRef="Task_TapSafe" />
    <bpmn:endEvent id="End_Escalated" name="Escalated to Tier-2">
      <bpmn:incoming>Flow_AwakeNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AwakeNo" name="No (30s Timeout)" sourceRef="Gateway_PatientAwake" targetRef="End_Escalated" />
    <bpmn:userTask id="Task_EndSession" name="Tap &#39;End Sleep Session&#39;">
      <bpmn:incoming>Flow_P6</bpmn:incoming>
      <bpmn:outgoing>Flow_P7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_SessionComplete" name="End: Session Complete">
      <bpmn:incoming>Flow_P7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Bedtime" targetRef="Task_PasskeyAuth" />
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_PasskeyAuth" targetRef="Task_Stage1Cal" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Task_Stage1Cal" targetRef="Task_Stage2Cal" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_Stage2Cal" targetRef="Task_SleepMonitoring" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_SleepMonitoring" targetRef="Gateway_Tier1Alarm" />
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Task_TapSafe" targetRef="Task_EndSession" />
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Task_EndSession" targetRef="End_SessionComplete" />
  </bpmn:process>

  <!-- SWIMLANE 4: EMERGENCY CENTER -->
  <bpmn:process id="Process_EmergencyCenter" isExecutable="true">
    <bpmn:laneSet id="LaneSet_EmergencyCenter">
      <bpmn:lane id="Lane_EmergencyCenter" name="Emergency Center">
        <bpmn:flowNodeRef>Start_EmergencyTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DashboardAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MetricCollection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaregiverCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DispatchEMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DispatchResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_EmergencyTrigger" name="Start: 30s Unacknowledged Apnea Trigger">
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DashboardAlert" name="Dashboard Alert Pop-up">
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_MetricCollection" name="Collect Emergency Alert Metrics">
      <bpmn:incoming>Flow_E2</bpmn:incoming>
      <bpmn:outgoing>Flow_E3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CaregiverCall" name="Trigger Voice Call &#38; SMS to Caregiver">
      <bpmn:incoming>Flow_E3</bpmn:incoming>
      <bpmn:outgoing>Flow_E4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DispatchEMS" name="Dispatch Local EMS / 911 Responders">
      <bpmn:incoming>Flow_E4</bpmn:incoming>
      <bpmn:outgoing>Flow_E5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_DispatchResolved" name="End: Emergency Resolved">
      <bpmn:incoming>Flow_E5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="Start_EmergencyTrigger" targetRef="Task_DashboardAlert" />
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_DashboardAlert" targetRef="Task_MetricCollection" />
    <bpmn:sequenceFlow id="Flow_E3" sourceRef="Task_MetricCollection" targetRef="Task_CaregiverCall" />
    <bpmn:sequenceFlow id="Flow_E4" sourceRef="Task_CaregiverCall" targetRef="Task_DispatchEMS" />
    <bpmn:sequenceFlow id="Flow_E5" sourceRef="Task_DispatchEMS" targetRef="End_DispatchResolved" />
  </bpmn:process>

  <!-- SWIMLANE 5: CLINIC & PHYSICIAN [FUTURE] -->
  <bpmn:process id="Process_Clinic" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Clinic">
      <bpmn:lane id="Lane_ClinicPhysician" name="Clinic &#38; Physician [Future]">
        <bpmn:flowNodeRef>Start_ClinicSync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DoctorSync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhysicianReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClinicComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ClinicSync" name="Start: Morning Report Trigger">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DoctorSync" name="Sync Morning Sleep Scores &#38; AHI Reports [Future]">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PhysicianReview" name="Physician Reviews AHI Classification &#38; Notes [Future]">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ClinicComplete" name="End: Diagnosis Updated">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_ClinicSync" targetRef="Task_DoctorSync" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_DoctorSync" targetRef="Task_PhysicianReview" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_PhysicianReview" targetRef="End_ClinicComplete" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SleepApnea">
    <bpmndi:BPMNPlane id="BPMNPlane_SleepApnea" bpmnElement="Collaboration_SleepApnea">
      <bpmndi:BPMNShape id="Participant_Onboarding_di" bpmnElement="Participant_Onboarding" isHorizontal="true"><dc:Bounds x="10" y="50" width="1680" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Backoffice_di" bpmnElement="Participant_Backoffice" isHorizontal="true"><dc:Bounds x="10" y="240" width="1680" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Patient_di" bpmnElement="Participant_Patient" isHorizontal="true"><dc:Bounds x="10" y="430" width="1680" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_EmergencyCenter_di" bpmnElement="Participant_EmergencyCenter" isHorizontal="true"><dc:Bounds x="10" y="650" width="1680" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Clinic_di" bpmnElement="Participant_Clinic" isHorizontal="true"><dc:Bounds x="10" y="870" width="1680" height="180" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>